# POC-001 Market HFT OS - Environment Configuration Template
# Copy this file to individual .env credential files as required by serverSecretLoader.ts
# NEVER commit real credentials, tokens, or private keys to version control.

# -----------------------------------------------------------------------------
# Database & Persistence
# -----------------------------------------------------------------------------
# Postgres connection URL (Postgres.env)
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/market_hft_os

# -----------------------------------------------------------------------------
# LLM & Reasoning Providers
# -----------------------------------------------------------------------------
# Google Gemini API Key (GeminiAPIKey.env)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq High-Speed Inference API Key (Groq_Key.env)
GROQ_API_KEY=your_groq_api_key_here

# Mistral AI API Key (MistralAPI.env)
MISTRAL_API_KEY=your_mistral_api_key_here

# OpenRouter Multi-Model Gateway (OPENRouterAPI.env)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# HuggingFace Serverless Inference (HuggingFaceAPI.env)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Local Ollama Inference (OllamaAPIKey.env)
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Market Data & Brokerage
# -----------------------------------------------------------------------------
# Alpaca Trading & Market Data (Alpaca_Key.env / Alpaca_Secret.env)
APCA_API_KEY_ID=your_alpaca_key_id_here
APCA_API_SECRET_KEY=your_alpaca_secret_key_here

# Eulerpool Macroeconomic Terminal (Eulerpool.env)
EULERPOOL_API_KEY=your_eulerpool_api_key_here

# -----------------------------------------------------------------------------
# Geospatial & Web Scraping
# -----------------------------------------------------------------------------
# Google Maps Geocoding & Routes (GMAPSAPIKey.env)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# TinyFish Web Scraping Crawler (TinyFish.env)
TINYFISH_API_KEY=your_tinyfish_api_key_here

# -----------------------------------------------------------------------------
# Social & Developer Graph Gateways
# -----------------------------------------------------------------------------
# Meta Developer Graph Gateway (MetaGatewayAPI.env / METAAPPIDANDSECRET.env)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_CONFIG_ID=your_meta_config_id_here
GRAPH_API_ACCESS_TOKEN=your_graph_api_access_token_here
THREADS_APP_ID=your_threads_app_id_here
THREADS_APP_SECRET=your_threads_app_secret_here

# -----------------------------------------------------------------------------
# Version Control & Automation
# -----------------------------------------------------------------------------
# GitHub Automation Token (GithubPersonalAccessTokenFORAG.env)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here
