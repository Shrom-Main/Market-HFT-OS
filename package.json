{
  "name": "market-hft-os",
  "version": "0.1.0",
  "description": "POC-001 Market HFT Operating System Core Implementation",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:json": "vitest run --reporter=json --outputFile=test-results.json",
    "typecheck": "tsc --noEmit",
    "sync": "python scripts/sync_repos.py --once",
    "sync:push": "python scripts/sync_repos.py --once --push-only"
  },
  "dependencies": {
    "json-canonicalize": "3.0.1",
    "pg": "8.23.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "20.12.7",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.4.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "vite": "6.4.4",
    "esbuild": "0.25.0"
  }
}
